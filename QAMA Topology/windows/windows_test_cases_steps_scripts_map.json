  "C53": {
    "script_file_path": "tests/windows/hpx_rebranding/scripts/add_device/test_suite_02_add_device.py",
    "correlation_map": {
      "1. Log in to the application with valid credentials.": {
        "Invoke class setup fixture for OTA regression": "@pytest.mark.usefixtures('class_setup_fixture_ota_regression', 'function_setup_to_reset_and_launch_myhp')",
        "Kill existing HPX processes": "request.cls.fc.kill_hpx_process()",
        "Delete web password credentials": "request.cls.fc.web_password_credential_delete()",
        "Load HPID credentials from JSON": "hpid_credentials = saf_misc.load_json(ma_misc.get_abs_path(HPX_ACCOUNT.account_details_path))['hpid']",
        "Store username and password": "cls.user_name, cls.password = (hpid_credentials['username'], hpid_credentials['password'])",
        "Minimize Chrome browser": "cls.profile.minimize_chrome()",
        "Click home button for logged-in user": "self.devicesMFE.click_home_loggedin()",
        "Sign in with user credentials": "self.fc.sign_in(self.user_name, self.password, self.web_driver, user_icon_click=False)",
        "Verify top profile icon shows signed-in state": "logged_in = self.profile.verify_top_profile_icon_signed_in()",
        "Assert user is signed in": "assert logged_in, \"User not signed in/After signing in the 'Sign In' button failed to disappear after 20 seconds\""
      },
      "2. Open the Add Device page and select \"Search by Serial Number\".": {
        "Verify add device button is present": "self.profile.verify_add_device_button()",
        "Click add device button": "self.profile.click_add_device_button()",
        "Verify add device page is displayed": "assert self.add_device.verify_add_device_page(), 'Add device page is not displayed'",
        "Verify search by serial number button is present": "assert self.add_device.verify_search_by_serial_number_btn(), 'search by serial number button not found'",
        "Click search by serial number button": "self.add_device.click_search_by_serial_number_btn()"
      },
      "3. Enter a valid serial number.": {
        "Input serial number": "self.add_device.input_enter_serial_number('8CC5281Y49')",
        "Get entered serial number": "entered_value = self.add_device.get_entered_serial_number()",
        "Assert serial number is correct": "assert entered_value == '8CC5281Y49', f'Serial number not displayed correctly, found: {entered_value}'"
      },
      "4. Enter a valid product number.": {
        "Verify product number textbox is present": "assert self.add_device.verify_product_number_textbox(), 'Product number textbox not found'",
        "Input product number": "self.add_device.input_enter_product_number('9U886PA#ACJ')",
        "Get entered product number": "entered_value = self.add_device.get_entered_product_number()",
        "Assert product number is correct": "assert entered_value == '9U886PA#ACJ', f'Product number not displayed correctly, found: {entered_value}'"
      },
      "5. Click the \"Add Device\" confirmation link/button.": {
        "Click add device hyperlink": "self.add_device.click_add_device_hyperlink()",
        "Verify newly added device name is displayed": "assert self.add_device.verify_newly_added_devicename(), 'Newly added device name is not displayed'"
      }
    }
  },
